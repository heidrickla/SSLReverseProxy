{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "SslReverseProxy": "Information"
    }
  },
  "ConnectionStrings": {
    "//": "Point at a persisted volume in production.",
    "AppDb": "Data Source=/data/sslrp.db"
  },
  "Security": {
    "//": "Set ApiKeyPepper via env (Security__ApiKeyPepper) or user-secrets — never here.",
    "RequireMutualTls": false,
    "AllowedClientCertificateThumbprints": [],
    "CorsAllowedOrigins": [],
    "TrustedProxies": []
  },
  "Proxy": {
    "CaddyPath": "/usr/bin/caddy",
    "AdminEndpoint": "http://127.0.0.1:2019",
    "ConfigDirectory": "/data/proxy-config",
    "AcmeContactEmail": null,
    "UseAcmeStaging": false,
    "AllowLoopbackUpstreams": false,
    "AllowPrivateUpstreams": true
  }
}
