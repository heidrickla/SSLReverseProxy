<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <!-- Override vulnerable transitive Microsoft.OpenApi 2.0.0 with a patched 2.x release. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.9.0" />
    <!-- Design-time only: required by the EF Core tools in the startup project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Design-time only (EF Core Design's MSBuild tooling pulls Pkcs 9.0.0): pin the patched release. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SslReverseProxy.Core\SslReverseProxy.Core.csproj" />
    <ProjectReference Include="..\SslReverseProxy.Infrastructure\SslReverseProxy.Infrastructure.csproj" />
  </ItemGroup>

</Project>
