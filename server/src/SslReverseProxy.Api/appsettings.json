{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AppDb": "Data Source=sslrp.db"
  },
  "Security": {
    "//": "ApiKeyPepper and client-cert thumbprints MUST come from user-secrets / environment, never this file.",
    "RequireMutualTls": false,
    "AllowedClientCertificateThumbprints": [],
    "CorsAllowedOrigins": []
  },
  "Proxy": {
    "CaddyPath": "caddy",
    "AdminEndpoint": "http://127.0.0.1:2019",
    "ConfigDirectory": "proxy-config",
    "AcmeContactEmail": null,
    "UseAcmeStaging": true,
    "AllowLoopbackUpstreams": true,
    "AllowPrivateUpstreams": true
  }
}
